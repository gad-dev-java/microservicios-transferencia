{
  "realm": "banco-demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      { "name": "transferencias:crear" },
      { "name": "transferencias:leer" },
      { "name": "contabilidad:registrar" },
      { "name": "riesgo:evaluar" }
    ]
  },
  "clients": [
    {
      "clientId": "banco-cli",
      "name": "Cliente de demostracion local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["profile", "email", "roles", "web-origins", "acr", "basic"],
      "protocolMappers": [
        {
          "name": "banco-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "banco-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "transferencias-service",
      "name": "Cliente de servicio de transferencias",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-transferencias-service-only",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["profile", "email", "roles", "web-origins", "acr", "basic"],
      "protocolMappers": [
        {
          "name": "banco-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "banco-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "cliente1",
      "firstName": "Cliente",
      "lastName": "Uno",
      "email": "cliente1@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "cliente1-local", "temporary": false }],
      "realmRoles": ["transferencias:crear", "transferencias:leer"]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "cliente2",
      "firstName": "Cliente",
      "lastName": "Dos",
      "email": "cliente2@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "cliente2-local", "temporary": false }],
      "realmRoles": ["transferencias:crear", "transferencias:leer"]
    }
  ]
}
